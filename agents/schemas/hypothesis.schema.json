{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hypothesis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "hypothesis": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supported",
        "refuted",
        "inconclusive"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "file:line, command output, API response"
    },
    "fix_location": {
      "type": [
        "string",
        "null"
      ],
      "description": "where the fix belongs if supported"
    },
    "next_check": {
      "type": [
        "string",
        "null"
      ],
      "description": "if inconclusive: the single most useful next check"
    }
  },
  "required": [
    "hypothesis",
    "verdict",
    "evidence",
    "fix_location",
    "next_check"
  ]
}
