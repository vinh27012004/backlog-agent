{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobId": { "type": ["string", "null"] },
        "passed": { "type": "boolean" },
        "codePassed": { "type": "boolean" },
        "failKind": { "type": ["string", "null"] },
        "signature": { "type": ["string", "null"] },
        "repeat": { "type": "integer" },
        "next": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] },
        "tail": { "type": ["string", "null"], "description": "The failing check's tail, cut to the lines that point at the cause (at most 15)." },
        "findings": { "type": "array", "items": { "type": "string" }, "description": "Gate warnings, one line each." }
      },
      "required": ["jobId", "passed", "codePassed", "failKind", "signature", "repeat", "next", "hint", "tail", "findings"]
    },
    "answer_fixed": {
      "type": "boolean",
      "description": "True when you fixed answers/<ID>/submit.json after an answer_invalid gate with codePassed true."
    },
    "mvs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario": { "type": "string" },
              "problem": { "type": "string" }
            },
            "required": ["scenario", "problem"]
          }
        }
      },
      "required": ["total", "passed", "missing"]
    },
    "recommendation": {
      "type": "string",
      "enum": ["publish", "retry", "orchestrator_gate"]
    },
    "retry_brief": {
      "type": ["string", "null"],
      "description": "For retry: failKind, signature, repeat, the cut tail and the missing scenarios, ready for <previous_attempt>."
    },
    "summary": { "type": "string" }
  },
  "required": ["gate", "answer_fixed", "mvs", "recommendation", "retry_brief", "summary"]
}
