                <mxCell id="flow-lookup" value="tra cứu chỉ đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.233;entryY=0;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="flowv9" target="flow-company">
                    <mxGeometry relative="1" as="geometry"></mxGeometry>
                </mxCell>
                <mxCell id="flow-baseline" value="&lt;b&gt;Baseline đã fail ở bản phát&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;owner sửa product code → baseline_fixed → helper commit main; item cần full suite chờ commit này, sync rồi refresh_candidate.&lt;br&gt;Worker không sửa issued tests hoặc cấu hình test; helper không có reviewer/gate chạy lại độc lập.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="180" y="850" width="800" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="flow-recovery" value="&lt;b&gt;Bị kill / resume&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;journal + git + server là nguồn bền; RESUME_GAME_V1 dựng root mới, khôi phục publish / submit intent.&lt;br&gt;Root dùng wait_for_update; worker báo blocked/candidate qua checkpoint, không send_message root.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="850" width="820" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="kb" name="KB và code intelligence">
        <mxGraphModel dx="1900" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="kb-title" value="KB và code intelligence — thành phần đang có trong code (05/11/2026)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fillColor=none;strokeColor=none;align=left;fontSize=22;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="30" y="20" width="1800" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="kb-subtitle" value="KB nội bộ: kinh nghiệm kỹ thuật của đội. Company KB: chuẩn/ngữ nghĩa nghiệp vụ của trận. Codegraph: index quan hệ của source hiện tại." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="1">
                    <mxGeometry x="30" y="75" width="1800" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="kb-local" value="&lt;b&gt;1 · KB nội bộ — Markdown trong pack/skills/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;stack-notes/&amp;lt;stack&amp;gt;.md: pitfalls theo stack&lt;br&gt;backlog-references/bug-patterns.md: pattern + dấu hiệu&lt;br&gt;Helper đọc các dòng pitfall; worker nhận thêm&lt;br&gt;domain-checks / pi-triage / evidence-playbook theo loại item&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="155" width="420" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="kb-code" value="&lt;b&gt;2 · Source / manifest / codegraph&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;manifest → stack + framework (detectDomain)&lt;br&gt;git grep → file / module khớp từ khóa item&lt;br&gt;.codegraph/codegraph.db → topology (SQLite read-only)&lt;br&gt;codegraph-state.mjs → freshness theo source snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="40" y="395" width="420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="kb-item" value="&lt;b&gt;Đầu vào item + MVS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;title · description · startInstruction&lt;br&gt;workText / codeTerms / countCriteria&lt;br&gt;Nội dung item là dữ liệu untrusted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="40" y="625" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="kb-signals" value="&lt;b&gt;Code KB — pack/src/decide/signals.mjs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;kbPitfalls(stack): đọc pitfall + ghi nguồn file:line&lt;br&gt;kbInsights(text, {root}): domain · risk_factors&lt;br&gt;known_pitfalls · known_pitfall_source · basis: heuristic&lt;br&gt;itemSignals: gộp đặc trưng item + code + topology + kb&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="550" y="200" width="600" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="kb-decisions" value="&lt;b&gt;Triage / route / tier model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;decide/decisions.mjs: signalBlocks → kb_insights&lt;br&gt;Jev intake; confidence thấp / lỗi / tắt → fallback luật code&lt;br&gt;difficultyFromSignals xét cả rủi ro KB và phạm vi code&lt;br&gt;decide/models.mjs + config/models.json → model / effort&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="200" width="540" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="kb-limit" value="&lt;b&gt;Độ tin cậy của gợi ý&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;KB local dùng để chọn hướng điều tra, không chứng minh nguyên nhân.&lt;br&gt;Topology chỉ dùng khi index fresh; thiếu / cũ / bị cắt thì không kết luận impact nhỏ.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="550" y="475" width="600" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="kb-jev" value="&lt;b&gt;Ranh giới Jev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Đầu vào: item đã giới hạn + signals / topology / KB insights.&lt;br&gt;Không gửi code nguồn, diff hoặc credential. Luật cứng giữ trong code.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="475" width="540" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="kb-brief" value="&lt;b&gt;match/workflow.mjs → brief.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;prepare: knowledgeHints = ji.signals.kb → &amp;lt;knowledge_hints&amp;gt;&lt;br&gt;itemSkills / skillFiles / skillText → &amp;lt;skill_text&amp;gt;&lt;br&gt;company_facts: đường dẫn dữ liệu đã prefetch&lt;br&gt;PI chỉ báo cáo: &amp;lt;report_only_pi&amp;gt; thay skill_text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="550" y="665" width="600" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="kb-worker" value="&lt;b&gt;team_fixer điều tra → kiểm chứng → bàn giao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;đọc brief, source và tài liệu công ty được lưu&lt;br&gt;codegraph_* tìm quan hệ; rg / source khi graph không đủ&lt;br&gt;company_lookup để lấy bài đầy đủ / log / test data&lt;br&gt;kết luận dẫn nguồn file:line + fact ID/section + check thực tế&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="665" width="540" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="kb-company" value="&lt;b&gt;3 · Company KB / Company Tools MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Game Master: /api/v1/mcp/&amp;lt;matchId&amp;gt;&lt;br&gt;kb_search: chuẩn / định nghĩa nghiệp vụ&lt;br&gt;search_logs: log production · get_test_data: QA fixtures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
